# Renforce la résilience de l'installation sur des réseaux instables.
# Le journal fourni montre "getaddrinfo ENOENT registry.npmjs.org" : une
# résolution DNS ayant échoué au milieu de l'installation (coupure réseau,
# DNS du fournisseur d'accès temporairement indisponible, ou VPN/pare-feu
# qui intercepte la requête). Ce n'est pas un problème du projet ; ces
# réglages réduisent la probabilité que l'incident se reproduise et,
# lorsqu'il se produit, permettent à npm de réessayer au lieu d'abandonner.
registry=https://registry.npmjs.org/
fetch-retries=5
fetch-retry-mintimeout=2000
fetch-retry-maxtimeout=30000
fetch-timeout=60000
prefer-offline=false
