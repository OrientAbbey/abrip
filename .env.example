# Configuration ABRIP — toutes les variables sont optionnelles.
# Ordre de résolution : valeurs par défaut du code → configs/*.yaml → ces variables.

# Emplacement des données (brut, curé, analytique, catalogue)
ABRIP_DATA_DIR=./data

# Service web
ABRIP_API__HOST=127.0.0.1
ABRIP_API__PORT=8000
# Origines autorisées en développement (le frontend Vite tourne sur 5173)
ABRIP_API__CORS_ORIGINS=["http://localhost:5173"]

# Journalisation : DEBUG, INFO, WARNING, ERROR
ABRIP_LOG_LEVEL=INFO

# Ingestion
ABRIP_INGESTION__CONCURRENCY=3
ABRIP_INGESTION__RETENTION_DAYS=30

# Parseur MRT : auto, bgpkit, mrtparse, pybgpstream, synthetic
ABRIP_ETL__PARSER=auto

# Confirmation plan de données (L1) — optionnel, troisième source seulement.
# Créer un jeton gratuit : dashboard.cloudflare.com -> My Profile -> API Tokens
ABRIP_ENRICHMENT__CLOUDFLARE_RADAR_TOKEN=
